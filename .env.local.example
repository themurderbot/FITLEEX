# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server only — never expose to client

# ─── Tap Payments ─────────────────────────────────────────────
TAP_SECRET_KEY=sk_test_...
TAP_PUBLIC_KEY=pk_test_...

# ─── Tabby ────────────────────────────────────────────────────
TABBY_SECRET_KEY=your-tabby-secret-key
TABBY_MERCHANT_CODE=your-merchant-code

# ─── Tamara ───────────────────────────────────────────────────
TAMARA_API_TOKEN=your-tamara-api-token
TAMARA_NOTIFICATION_TOKEN=your-tamara-notification-token  # For webhook signature verification

# ─── Edge Functions ───────────────────────────────────────────
CRON_SECRET=a-long-random-secret-for-cron-jobs

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
